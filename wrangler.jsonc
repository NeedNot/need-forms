{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "need-forms",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // no-reply@forms.neednot.net must belong to a domain onboarded to Email Sending.
  "vars": {
    "EMAIL_FROM": "no-reply@forms.neednot.net",
    "EMAIL_FROM_NAME": "Need Forms",
    "RETRY_BASE_SECONDS": "60",
    "RETRY_MAX_SECONDS": "3600",
    "MAX_PAYLOAD_BYTES": "100000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "need-forms",
      "database_id": "5d40dd61-d245-4a50-8cd9-cee9fce2b95c",
      "migrations_dir": "migrations"
    }
  ],
  // Local `wrangler dev` simulates this binding and does not deliver mail.
  // Add `"remote": true` only when you intentionally want local code to send real email.
  "send_email": [{ "name": "EMAIL" }],
  "queues": {
    "producers": [
      {
        "binding": "DELIVERY_QUEUE",
        "queue": "need-forms-delivery"
      }
    ],
    "consumers": [
      {
        "queue": "need-forms-delivery",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "need-forms-delivery-dlq"
      },
      {
        "queue": "need-forms-delivery-dlq",
        "max_batch_size": 10
      }
    ]
  },
  "routes": [{ "pattern": "forms.neednot.net", "custom_domain": true }],
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
